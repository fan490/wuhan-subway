{
  "name": "webgis-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm.cmd run dev",
    "dev:client": "cd client && npm.cmd run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "init-db": "cd server && npm.cmd run init-db",
    "install:all": "cd server && npm.cmd install && cd ../client && npm.cmd install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
